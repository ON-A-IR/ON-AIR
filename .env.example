TTS_PROVIDER=auto

# Free local high-quality TTS option.
# Download Piper and a Korean model, then set these paths.
PIPER_EXE=
PIPER_MODEL=
PIPER_CONFIG=
PIPER_ESPEAK_DATA=
# Multi-speaker Piper model: speaker A and B are used for the two hosts.
PIPER_SPEAKER_A=0
PIPER_SPEAKER_B=1

# Optional local voice cloning test. CPU works, but it can be slow.
XTTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
XTTS_DEVICE=cpu
TTS_HOME=

# Paid cloud TTS option.
ELEVENLABS_API_KEY=
# Optional. Defaults to Rachel.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
